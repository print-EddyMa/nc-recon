# NC Recon deployment settings. Copy to .env (never commit .env).

# REQUIRED. Long random secret; analysts paste it into Operations > Responder
# access. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
TERRATRIAGE_TOKEN=

# Public host name for HTTPS (Caddy). "localhost" for a local test.
NCR_DOMAIN=localhost

# OPTIONAL, free: Census API key -> seasonal/vacant-home adjustment of the
# displacement estimate. https://api.census.gov/data/key_signup.html
NCR_CENSUS_API_KEY=

# OPTIONAL, free: USGS Water Data API key (higher rate limits).
NCR_USGS_API_KEY=

# OPTIONAL: CPU threads for the damage model (default: all but two).
NCR_CPU_THREADS=

# OPTIONAL: per-client rate limits, requests per minute (defaults 30 / 600 / 120).
# NCR_RATE_WRITE_PER_MIN=30
# NCR_RATE_READ_PER_MIN=600
# NCR_RATE_FEED_PER_MIN=120

# OPTIONAL: extra origins the browser may call directly (space separated), e.g.
# a self-hosted basemap. Everything else is blocked by the Content Security Policy.
# NCR_CSP_CONNECT=

# OPTIONAL: who to contact about this deployment's requests (an email or URL).
# Sent in the User-Agent to the federal data APIs; weather.gov asks for one.
NCR_CONTACT=
