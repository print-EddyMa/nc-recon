# Python
__pycache__/
*.pyc
.venv/
venv/
.env
.env.local
.env.*.local
!.env.example
# Data & weights (large, not committed)
pipeline/weights/*
!pipeline/weights/.gitkeep
!pipeline/weights/README.md
pipeline/data/raw/*
pipeline/data/tiles/*
!pipeline/data/**/.gitkeep
# keep sample output committed? no
pipeline/data/output/*
!pipeline/data/output/.gitkeep
# Node
web/node_modules/
web/dist/
web/.vite/
# OS
.DS_Store

# Design tooling (Hallmark anti-slop skill, installed locally via `npx skills add`)
.agents/
.claude/

# pipeline data cache
pipeline/data/cache/*
!pipeline/data/cache/.gitkeep
pipeline/vendor_xview2_1st/

# web build
web/dist/

# No sample assessment data is committed. Map tiles and per-area contract
# GeoJSON are generated on demand by the pipeline (locally or the hosted
# service) and served from web/public — never checked in.
web/public/tiles/

# Phase H — the /demo hook sequence's self-hosted basemap (~30 MB of CARTO
# dark-matter vector tiles). Regenerate with `npm run demo:assets` in web/.
# The rest of web/public/demo/ (radar frames, stitched Maxar stills, the
# baked GeoJSON/JSON) is committed so the sequence runs without a re-fetch.
web/public/demo/basemap/
web/public/data/*.geojson
# ...but the committed feeds ARE kept: the NC risk snapshots, the global live
# hazard snapshots, the Maxar catalogue metadata, and the (initially empty)
# NC event registry.
!web/public/data/events.json
!web/public/data/maxar_catalog.json
!web/public/data/nc/
!web/public/data/live/
