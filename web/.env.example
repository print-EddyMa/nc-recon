# Copy to .env.local for local dev, or set these in your host's build env.
# All are OPTIONAL — the app runs as a static site with none of them.

# Base path when hosting under a sub-path (e.g. "/terratriage/"). Default "/".
# VITE_BASE=/

# URL of the pipeline assessment service (server.py / the Docker image).
# In dev this defaults to http://127.0.0.1:8000. On a production build, if it
# is unset the Assess screen runs in "no service" mode (shows CLI commands).
# VITE_API_URL=https://terratriage-api.example.com

# Bearer token if the assessment service sets TERRATRIAGE_TOKEN.
# VITE_API_TOKEN=

# Free NASA FIRMS map key — enables the active-fire layer on the NC monitor.
# Get one at https://firms.modaps.eosdis.nasa.gov/api/map_key/
# VITE_FIRMS_KEY=
